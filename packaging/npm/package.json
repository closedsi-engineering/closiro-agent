  },
  "homepage": "https://github.com/closedsi-engineering/closiro-agent#readme",
  "bugs": "https://github.com/closedsi-engineering/closiro-agent/issues",
  "keywords": ["closiro", "snailer", "ai", "coding-agent", "cli"],
  "license": "MIT",
  "publishConfig": { "access": "public" }
